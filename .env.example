# ==============================================================================
# CONFIGURACAO DE VARIAVEIS DE AMBIENTE - FINANCAS PESSOAIS
# ==============================================================================
# Este arquivo serve como modelo. Para usar localmente:
# 1. Copie este arquivo para .env (ex: renomeie ou copie para .env)
# 2. Preencha os valores de acordo com seu provedor (Opcao A ou Opcao B).
#
# Para usar no Render:
# Acesse o painel do Render -> Seu Web Service -> Environment -> Add Environment Variable.
# Adicione as variaveis abaixo diretamente no painel do Render.
# ==============================================================================

# Porta do Servidor (Opcional, padrao: 3000 ou fornecido pelo Render)
PORT=3000

# ------------------------------------------------------------------------------
# OPCAO A: Envio via Gmail (Recomendado e Mais Rapido)
# ------------------------------------------------------------------------------
# ATENCAO: A senha NAO e a senha comum da sua conta Google!
# E uma 'Senha de App' de 16 caracteres gerada em:
# 1. Acesse: https://myaccount.google.com/security
# 2. Ative a 'Verificacao em duas etapas' (se ainda nao tiver)
# 3. Acesse 'Senhas de app' (ou busque na barra de pesquisa por 'Senhas de app')
# 4. De o nome 'Financas Pessoais' e clique em 'Criar'
# 5. Copie a senha de 16 letras gerada (pode colar com ou sem espacos)

GMAIL_USER=seu-email@gmail.com
GMAIL_PASS=sua-senha-de-app-16-digitos

# ------------------------------------------------------------------------------
# OPCAO B: Envio via Servidor SMTP Proprio (Hostinger, cPanel, Locaweb, SendGrid, etc.)
# ------------------------------------------------------------------------------
# Descomente e preencha caso nao use Gmail:

# SMTP_HOST=smtp.exemplo.com
# SMTP_PORT=587
# SMTP_USER=usuario@exemplo.com
# SMTP_PASS=sua-senha-forte
# SMTP_SECURE=false
# SMTP_FROM="Financas Pessoais" <usuario@exemplo.com>
