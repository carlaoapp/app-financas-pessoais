# ========================================================
# CONFIGURAÇÃO DE E-MAIL (RECUPERAÇÃO SEGURA DE SENHA)
# ========================================================
# Opção 1: Gmail (Recomendado e Gratuito)
# Crie uma Senha de App em: https://myaccount.google.com/apppasswords
GMAIL_USER=seu-email@gmail.com
GMAIL_PASS=sua-senha-de-app-16-digitos

# Opção 2: Servidor SMTP Próprio (Hostinger, Brevo, SendGrid, etc.)
# SMTP_HOST=smtp.seudominio.com
# SMTP_PORT=587
# SMTP_USER=contato@seudominio.com
# SMTP_PASS=suasenhasmtp
# SMTP_SECURE=false
# SMTP_FROM="Finanças Pessoais" <contato@seudominio.com>
